---
import { Image } from "astro:assets";
import { projects } from "../data/projects";
---

<section id="projects" class="work graphite-section">
  <div class="wrap">
    <div class="section-heading">
      <h2>Trabajo seleccionado<span class="muted">.</span></h2><p>
        Productos reales, retos distintos.<br />Una mirada a lo que he
        construido.
      </p>
    </div>
    <div class="project-grid">
      {
        projects.map((project, i) => (
          <article id={`project-${i}`} class={`project project-${i}`}>
            <a
              class="project-image"
              href={project.preview}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Abrir demo de ${project.title}`}
            >
              <>
                <Image
                  src={project.image}
                  alt={`Captura de la aplicación ${project.title}`}
                  widths={[480, 800, 1200]}
                  sizes="(max-width: 760px) 90vw, 45vw"
                  loading="lazy"
                />
                <span class="image-action" aria-hidden="true">
                  ↗
                </span>
              </>
            </a>
            <div class="project-title">
              <>
                <h3>{project.title}</h3>
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Ver código de ${project.title}`}
                >
                  Código ↗
                </a>
              </>
            </div>
            <>
              <p class="project-description">{project.description}</p>
              <ul class="tech-tags" aria-label="Tecnologías">
                {project.technologies.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>
              <p class="project-status">{project.status}</p>
            </>
          </article>
        ))
      }
    </div>
    <a
      class="text-link"
      href="https://github.com/FranciscoDastres?tab=repositories"
      target="_blank"
      rel="noopener noreferrer"
      >Más código, más ideas en GitHub <span aria-hidden="true">↗</span></a
    >
  </div>
</section>
