---
const skills = [
  {
    name: "TypeScript",
    icon: "typeScript",
    category: "Lenguaje",
    description:
      "Código tipado para conectar interfaces, lógica y datos con mayor claridad. Es la base de mi trabajo en desarrollo full stack.",
    accent: "#82b4ff",
  },
  {
    name: "React",
    icon: "react",
    category: "Frontend",
    description:
      "Interfaces construidas con componentes, estados y recorridos que responden a la interacción de cada persona.",
    accent: "#8cdeef",
  },
  {
    name: "Node.js",
    icon: "nodejs",
    category: "Backend",
    description:
      "Servicios y APIs que conectan la experiencia visible con las reglas y los datos de una aplicación.",
    accent: "#a0cc92",
  },
  {
    name: "PostgreSQL",
    icon: "postgreSQL",
    category: "Datos",
    description:
      "Datos relacionados y consultas para organizar información de productos, usuarios y operaciones.",
    accent: "#98b3d2",
  },
  {
    name: "AWS",
    icon: "aws",
    category: "Cloud",
    description:
      "Experiencia con servicios en la nube, especialmente EC2, para ejecutar aplicaciones y administrar sus entornos.",
    accent: "#f2c28e",
  },
  {
    name: "Docker",
    icon: "docker",
    category: "Infraestructura",
    description:
      "Entornos reproducibles para desarrollar y ejecutar servicios con sus dependencias.",
    accent: "#96c9f4",
  },
  {
    name: "Tailwind CSS",
    icon: "tailwindcss",
    category: "Diseño de interfaces",
    description:
      "Sistemas de estilos que permiten cuidar composición, jerarquía y adaptación a distintos tamaños de pantalla.",
    accent: "#9cdfea",
  },
  {
    name: "Astro",
    icon: "astro",
    category: "Experiencias web",
    description:
      "Sitios centrados en contenido y rendimiento, con componentes interactivos donde la experiencia los necesita.",
    accent: "#eab0ce",
  },
  {
    name: "Git",
    icon: "git",
    category: "Colaboración",
    description:
      "Versiones y ramas para trabajar de forma ordenada, revisar cambios y mantener la evolución de un proyecto.",
    accent: "#efa899",
  },
];
---

<section id="stack" class="stack-section" aria-labelledby="stack-title">
  <div class="wrap">
    <div class="section-heading">
      <div>
        <span class="section-label">Mi stack</span><h2 id="stack-title">
          Las herramientas.<br />La intención detrás.
        </h2>
      </div><p>
        Una tecnología cobra sentido<br />cuando resuelve el problema correcto.
      </p>
    </div><div class="stack-layout">
      <div class="stack-feature">
        <div class="stack-orbit" aria-hidden="true">
          <div class="stack-ring"></div><div class="stack-ring ring-offset">
          </div><img
            id="stack-feature-icon"
            src="/svg/typeScript.svg"
            alt=""
            width="90"
            height="90"
          /><span class="orbit-point"></span>
        </div><div class="stack-feature-copy">
          <span id="stack-feature-category">Lenguaje</span><h3
            id="stack-feature-name"
          >
            TypeScript
          </h3><p id="stack-feature-description">{skills[0].description}</p>
        </div>
        <div class="stack-feature-navigation" hidden>
          <button
            type="button"
            class="circle-button"
            id="stack-prev"
            aria-label="Tecnología anterior">←</button
          ><span id="stack-position">01 / 09</span><button
            type="button"
            class="circle-button"
            id="stack-next"
            aria-label="Tecnología siguiente">→</button>
        </div>
      </div><div class="stack-grid" aria-label="Explorar tecnologías">
        {
          skills.map((skill, i) => (
            <button
              class="stack-card"
              type="button"
              aria-pressed={i === 0 ? "true" : "false"}
              aria-controls="stack-feature-name stack-feature-description"
              data-name={skill.name}
              data-icon={skill.icon}
              data-category={skill.category}
              data-description={skill.description}
              style={`--skill-accent:${skill.accent}`}
            >
              <>
                <img
                  src={`/svg/${skill.icon}.svg`}
                  width="36"
                  height="36"
                  alt=""
                  loading="lazy"
                />
                <span class="stack-card-name">{skill.name}</span>
                <span class="stack-card-category">{skill.category}</span>
                <span class="stack-card-arrow" aria-hidden="true">
                  ↗
                </span>
              </>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>
<script>
  const cards = document.querySelectorAll<HTMLButtonElement>(".stack-card");
  function select(card: HTMLButtonElement) {
    const position = document.querySelector("#stack-position");
    if (position)
      position.textContent = `${String(Array.from(cards).indexOf(card) + 1).padStart(2, "0")} / 09`;
    cards.forEach((item) =>
      item.setAttribute("aria-pressed", String(item === card)),
    );
    const icon = document.querySelector<HTMLImageElement>(
      "#stack-feature-icon",
    );
    if (icon) icon.src = `/svg/${card.dataset.icon}.svg`;
    for (const key of ["name", "category", "description"]) {
      const target = document.querySelector(`#stack-feature-${key}`);
      if (target) target.textContent = card.dataset[key] || "";
    }
    const feature = document.querySelector<HTMLElement>(".stack-feature");
    feature?.style.setProperty(
      "--skill-accent",
      card.style.getPropertyValue("--skill-accent"),
    );
  }
  const navigation = document.querySelector<HTMLElement>(
    ".stack-feature-navigation",
  );
  if (navigation) navigation.hidden = false;
  function step(direction: number) {
    const current = Array.from(cards).findIndex(
      (card) => card.getAttribute("aria-pressed") === "true",
    );
    select(cards[(current + direction + cards.length) % cards.length]);
  }
  document
    .querySelector("#stack-prev")
    ?.addEventListener("click", () => step(-1));
  document
    .querySelector("#stack-next")
    ?.addEventListener("click", () => step(1));
  cards.forEach((card) => {
    card.addEventListener("click", () => select(card));
    card.addEventListener("focus", () => select(card));
    card.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "mouse") select(card);
    });
  });
</script>
