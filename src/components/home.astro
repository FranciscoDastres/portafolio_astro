---
import { Image } from "astro:assets";
import { projects } from "../data/projects";
---

<section id="home" class="hero wrap">
  <div class="hero-top">
    <p>
      Francisco Meza Dastres<br /><span
        >Ingeniero informático & desarrollador full stack</span>
    </p><p class="location">
      <span class="status-dot"></span>Santiago, Chile <time id="local-time"
      ></time>
    </p>
  </div>
  <h1>Ideas que se convierten<br />en experiencias.</h1>
  <div class="hero-bottom">
    <p>
      Combino código, curiosidad y atención al detalle para construir productos
      digitales que funcionan y se sienten bien.
    </p><a class="button button-light" href="#projects"
      >Explorar mi trabajo <span aria-hidden="true">↘</span></a>
  </div>
  <div class="project-stage" aria-label="Una selección de mis proyectos">
    {
      projects.slice(0, 3).map((project, i) => (
        <a
          class={`stage-screen screen-${i}`}
          href="#projects"
          aria-label={`Ver proyecto ${project.title}`}
        >
          <>
            <div class="browser-bar">
              <>
                <span />
                <span />
                <span />
                <small>{project.title}</small>
              </>
            </div>
            <Image
              src={project.image}
              alt={`Interfaz de ${project.title}`}
              widths={[480, 800]}
              sizes="(max-width: 600px) 80vw, 45vw"
              loading="eager"
            />
          </>
        </a>
      ))
    }
    <div class="stage-caption">
      <span class="status-dot"></span>Hecho con intención. Construido con
      código.
    </div>
  </div>
  <div class="hero-foot">
    <span>Desarrollo web, de la idea al producto.</span><a href="#projects"
      >Sigue explorando <span aria-hidden="true">↓</span></a>
  </div>
</section>
<script>
  const clock = document.querySelector<HTMLTimeElement>("#local-time");
  const updateClock = () => {
    if (clock) {
      clock.textContent = new Intl.DateTimeFormat("es-CL", {
        timeZone: "America/Santiago",
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      }).format(new Date());
      clock.dateTime = new Date().toISOString();
    }
  };
  updateClock();
  setInterval(updateClock, 60000);
</script>
