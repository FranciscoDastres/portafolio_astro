---
import "@fontsource-variable/manrope";
import "../styles/global.css";
interface Props {
  title: string;
}
const { title } = Astro.props;
const description =
  "Soy Francisco Meza Dastres, ingeniero informático en Santiago de Chile. Desarrollo experiencias web con React, TypeScript y Node.js.";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#16141c" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href="https://portafolio-astro-psi.vercel.app/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:url"
      content="https://portafolio-astro-psi.vercel.app/"
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta
      property="og:image"
      content="https://portafolio-astro-psi.vercel.app/blackmichiestudio.png"
    />
    <title>{title}</title>
  </head>
  <body><a class="skip-link" href="#main">Saltar al contenido</a><slot /></body>
</html>
